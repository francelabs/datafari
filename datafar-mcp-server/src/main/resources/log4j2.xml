<?xml version="1.0" encoding="UTF-8"?>
<Configuration>

    <!-- Datafari appender -->
    <RollingFile name="MCP-server" fileName="/opt/datafari/logs/mcp-server.log" filePattern="/opt/datafari/logs/mcp-server.log.%d{yyyy-MM-dd}.log">
        <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        <PatternLayout>
            <Pattern>%5p %d{yyyy-MM-dd'T'HH:mm:ss'Z'} (%t) - MCP|Datafari|%c{3}|%m%n</Pattern>
        </PatternLayout>
        <Policies>
            <TimeBasedTriggeringPolicy interval="1"/>
            <SizeBasedTriggeringPolicy size="10MB" />
        </Policies>
        <DefaultRolloverStrategy max="10" />
    </RollingFile>

</Configuration>
